# Preserve exact bytes for the override package and its SHA-256 manifests.
# This disables line-ending conversion without disabling text diffs.
overrides/** -text whitespace=cr-at-eol
overrides/evidence/preprocessing_decision_excerpts.md whitespace=cr-at-eol,-blank-at-eof

# Keep analysis fingerprints and completed output checksums portable.
run.py -text whitespace=cr-at-eol
src/** -text whitespace=cr-at-eol
steps/** -text whitespace=cr-at-eol
tests/** -text whitespace=cr-at-eol
outputs/** -text whitespace=cr-at-eol
# Preserve the upstream font license's original whitespace.
assets/fonts/OFL.txt whitespace=-blank-at-eol
